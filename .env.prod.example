# =============================================================================
# Ashfield Account: 운영 환경 변수 (docs/deploy.md)
#
# 서버에서 `scripts/prod.sh init-env` (로컬: make deploy-init) 가 이 파일을 .env.prod 로 복사하고
# __GENERATE__ 자리를 openssl 로 채운다. .env.prod 는 서버에만 둔다 (gitignore).
# 키 설명은 .env.example.
# =============================================================================

COMPOSE_PROJECT_NAME=ashfield-account-prod

# 앱 포트 (LAN 바인딩: 앞단 리버스 프록시가 받는다)
APP_HOST_PORT=3300

# 공개 주소 = OIDC issuer. 끝 슬래시 없이.
ACCOUNT_URL=https://account.ashfieldlab.dev
BETTER_AUTH_SECRET=__GENERATE__

POSTGRES_USER=ashfield
POSTGRES_PASSWORD=__GENERATE__
POSTGRES_DB=ashfield_account

# 로그인 수단: 최소 하나는 채울 것. 콜백 URL:
#   ${ACCOUNT_URL}/api/auth/callback/google
#   ${ACCOUNT_URL}/api/auth/callback/github
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 가입과 로그인을 허용할 이메일 (쉼표 구분). 비우면 공개 가입: 운영에서는 반드시 채울 것.
# init-env 에 ADMIN_EMAIL 을 주면 비어 있을 때 그 값으로 채운다.
ALLOWED_EMAILS=

# 1st-party 앱 공개 주소 (토큰 aud, redirect URI 기본값의 기준)
CALENDAR_URL=https://calendar.ashfieldlab.dev
DRIVE_URL=https://drive.ashfieldlab.dev

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
