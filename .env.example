# =============================================================================
# Ashfield Account — 환경 변수
#   cp .env.example .env   (make setup 이 해 준다)
# 모든 값은 서버 전용이다. 읽는 곳은 lib/env.ts 한 곳.
# =============================================================================

# --- 서버 --------------------------------------------------------------------
# 계정 서버의 공개 주소 = OIDC issuer (토큰 `iss`). 끝 슬래시 없이.
# 운영 예: https://account.example.com
ACCOUNT_URL=http://localhost:3300

# 세션·서명 쿼리 암호화 키. 32바이트 이상 무작위. 생성: openssl rand -base64 32
# 운영에서 비어 있으면 서버가 시작을 거부한다.
BETTER_AUTH_SECRET=dev-only-change-me-0123456789abcdef0123456789

# Postgres. docker-compose.yml 의 기본값과 맞춤 (호스트 포트 5632).
DATABASE_URL=postgres://ashfield:ashfield_dev@localhost:5632/ashfield_account
# docker compose 가 쓰는 값 (DATABASE_URL 과 일치시킬 것)
POSTGRES_HOST_PORT=5632

# --- 로그인 수단 --------------------------------------------------------------
# CLIENT_ID 와 SECRET 이 둘 다 있을 때만 해당 버튼이 /sign-in 에 나타난다.
# 콜백 URL (각 제공자 콘솔에 등록):
#   Google: ${ACCOUNT_URL}/api/auth/callback/google
#   GitHub: ${ACCOUNT_URL}/api/auth/callback/github
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 가입·로그인을 허용할 이메일 (쉼표 구분, 대소문자 무시).
# 비워 두면 누구나 가입할 수 있다 (공개 가입) — 공개 인터넷에 띄울 땐 반드시 채울 것.
ALLOWED_EMAILS=

# 로컬·E2E 전용 이메일+비밀번호 로그인. NODE_ENV=production 이면 true 여도 꺼진다.
AUTH_DEV_PASSWORD_LOGIN=true

# --- 토큰 --------------------------------------------------------------------
# 액세스 토큰(JWT) 수명(초). 워크스페이스 소속 변경은 최대 이 시간 뒤(다음 갱신)에 반영된다.
ACCESS_TOKEN_TTL_SECONDS=900
# 리프레시 토큰 수명(초). 갱신할 때마다 회전(rotation)된다.
REFRESH_TOKEN_TTL_SECONDS=2592000

# --- 1st-party 앱 (npm run seed:clients) -------------------------------------
# 각 앱의 공개 주소. 액세스 토큰 `aud`(resource 식별자)로도 쓰인다 — 앱 백엔드가 검증할 값.
CALENDAR_URL=http://localhost:3100
DRIVE_URL=http://localhost:3200

# redirect URI (쉼표 구분). 비우면 기본값:
#   CALENDAR: ${CALENDAR_URL}/api/auth/callback/ashfield
#   DRIVE:    ${DRIVE_URL}/api/auth/callback/ashfield
#   SYNC:     http://localhost:1421/oauth/callback,http://127.0.0.1:1421/oauth/callback
CALENDAR_REDIRECT_URIS=
DRIVE_REDIRECT_URIS=
SYNC_REDIRECT_URIS=

# --- 로깅 --------------------------------------------------------------------
# debug 로그 카테고리 (auth,api,biz,ui 또는 *). 운영은 error 만.
NEXT_PUBLIC_LOG_CATEGORIES=
